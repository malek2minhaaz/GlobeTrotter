# ─────────────────────────────────────────────────────────────
# GlobeTrotter — environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=development

# ── Database (PostgreSQL) ────────────────────────────────────
# Local:  postgresql://postgres:postgres@localhost:5432/globetrotter?schema=public
# Neon:   postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/globetrotter?sslmode=require
#
# Use a DIRECT (non-pooled) connection string. Migrations need a session-level
# connection, and a locally-run server has no reason to go through a pooler. If
# your provider only gave you a pooled host it will contain "-pooler" — remove
# that segment to get the direct host.
DATABASE_URL=

# ── Server ───────────────────────────────────────────────────
PORT=4000
SERVER_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173

# ── Auth ─────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d
# How long a password-reset token stays valid, in minutes.
RESET_TOKEN_TTL_MINUTES=60

# ── File storage ─────────────────────────────────────────────
# "none" (default) serves safe fallback imagery and needs no credentials.
# Supported values: none | cloudinary | s3
STORAGE_PROVIDER=none
STORAGE_API_KEY=
STORAGE_API_SECRET=
STORAGE_BUCKET=
STORAGE_FOLDER=globetrotter

# ── Demo data ────────────────────────────────────────────────
# Password assigned to every seeded account (development only).
SEED_USER_PASSWORD=Password123!
